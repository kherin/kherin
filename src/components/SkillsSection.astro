---
interface Category {
  label: string;
  skills: string[];
}

const categories: Category[] = [
  {
    label: 'Languages',
    skills: ['Python', 'TypeScript', 'JavaScript', 'Dart', 'SQL'],
  },
  {
    label: 'Frameworks & libraries',
    skills: ['React', 'Vue.js', 'NestJS', 'Django', 'Flutter', 'Astro', 'Node.js'],
  },
  {
    label: 'AI, data science & ML',
    skills: ['LLM integration', 'Pandas', 'OpenCV', 'scikit-learn', 'Jupyter', 'Playwright (scraping)'],
  },
  {
    label: 'Cloud, DevOps & tools',
    skills: ['Docker', 'Azure', 'GitHub Actions', 'Ansible', 'Semgrep', 'Git'],
  },
];
---

<section id="skills" class="py-24 px-6 max-w-6xl mx-auto" aria-labelledby="skills-heading">
  <div class="reveal">
    <div class="flex items-baseline gap-4 mb-6">
      <span class="section-num text-5xl">02</span>
      <div class="kicker">Capabilities</div>
    </div>
    <h2 id="skills-heading" class="display text-4xl md:text-5xl text-ink mb-4">
      What I work with
    </h2>
    <p class="text-ink-dim max-w-xl mb-14">
      Five years across the stack — from LLM integrations and Python data pipelines
      to Flutter apps and Azure CI/CD.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12">
    {categories.map((cat, ci) => (
      <div class="reveal" data-delay={ci}>
        <div class="rule mb-5"></div>
        <h3 class="font-mono text-xs font-medium tracking-[0.18em] uppercase text-ink-dim mb-5">
          {cat.label}
        </h3>
        <ul class="space-y-2.5 list-none m-0 p-0">
          {cat.skills.map(skill => (
            <li class="text-ink text-[0.95rem] leading-snug">
              {skill}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
