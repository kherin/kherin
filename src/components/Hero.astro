---
// Hero — scroll-reactive topographic map (same ridge, drawn as contours).
//
// Layered rendering:
//   1. CSS ambient glow                     (instant paint, zero JS)
//   2. 2D canvas — contour map              (ember altitude sweep on scroll,
//                                            dash shimmer, headlamp on trail)
//   3. 2D canvas — waypoint HUD             (independent ~30fps cadence)
//   4. DOM — headline, captions, CTAs       (server-rendered, SEO-visible)
//
// The section is 300svh tall; the inner viewport is sticky. Scrolling
// through it climbs the contour levels. Falls back to a static 100svh
// hero with prefers-reduced-motion.
---

<section id="hero-scroll" class="hero-scroll relative bg-night-950" data-phase="0" aria-label="Hero">
  <div class="hero-sticky">
    <!-- Layer 0: instant-paint ambient (CSS only) -->
    <div class="hero-glow" aria-hidden="true"></div>

    <!-- Layer 1: topographic contour-map canvas -->
    <canvas id="topo-canvas" class="hero-layer" aria-hidden="true"></canvas>

    <!-- Vignette between the 3D scene and the HUD -->
    <div
      class="hero-layer pointer-events-none"
      style="background: radial-gradient(ellipse at center, transparent 34%, rgba(11,11,13,0.72) 100%);"
      aria-hidden="true"
    ></div>

    <!-- Layer 2: 2D waypoint HUD canvas -->
    <canvas id="hud-canvas" class="hero-layer" aria-hidden="true"></canvas>

    <!-- Scroll progress bar (CSS scroll-driven animation where supported) -->
    <div class="hero-progressbar" aria-hidden="true"></div>

    <!-- Layer 3: DOM content — phase 0: identity -->
    <div class="hero-main relative z-10 text-center px-6 max-w-5xl mx-auto flex flex-col items-center justify-center h-full">
      <div class="kicker mb-5 opacity-0 animate-[fadeUp_0.6s_0.2s_ease_forwards]">
        AI Engineer · Data Scientist · Trail Runner
      </div>

      <h1
        class="page-title display text-[clamp(3.25rem,11vw,8rem)] text-ink mb-5 opacity-0 animate-[fadeUp_0.8s_0.1s_cubic-bezier(0.16,1,0.3,1)_forwards]"
      >
        Kherin<br />Bundhoo
      </h1>

      <p class="text-ink-dim text-[clamp(0.95rem,2vw,1.15rem)] max-w-xl mb-3 opacity-0 animate-[fadeUp_0.6s_0.5s_ease_forwards]">
        Building LLM-powered tools and data systems from Mauritius —
        and running its mountain trails before sunrise.
      </p>

      <div class="font-mono text-xs text-ink-faint tracking-[0.25em] uppercase mb-9 opacity-0 animate-[fadeUp_0.5s_0.6s_ease_forwards]">
        Mauritius 🇲🇺 · Open to work
      </div>

      <div class="flex flex-wrap justify-center gap-3 opacity-0 animate-[fadeUp_0.6s_0.7s_ease_forwards]">
        <a href="/portfolio" class="btn text-sm py-3 px-6 gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          Portfolio
        </a>
        <a href="/blog" class="btn btn-ghost text-sm py-3 px-6 gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          Blog
        </a>
        <a href="/about" class="btn btn-ghost text-sm py-3 px-6 gap-2">About me</a>
      </div>

      <div class="mt-12 hidden sm:flex flex-wrap justify-center gap-6 font-mono text-xs opacity-0 animate-[fadeUp_0.6s_0.9s_ease_forwards]">
        {[
          { label: 'Python',      val: '5+ yrs' },
          { label: 'TypeScript',  val: '4+ yrs' },
          { label: 'Open Source', val: 'Active' },
          { label: 'Community',   val: 'PYMUG' },
        ].map(({ label, val }) => (
          <div class="flex flex-col items-center gap-1 border border-line px-3 py-1.5 bg-night-900/50 backdrop-blur-sm">
            <span class="text-ink-faint tracking-widest uppercase text-[0.6rem]">{label}</span>
            <span class="text-ink tracking-wider">{val}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Phase captions — revealed as the sweep climbs the contour levels -->
    <div class="hero-caption hero-caption-1">
      <div class="kicker mb-3">01 · Engineering</div>
      <p class="display text-4xl md:text-6xl text-ink">Full-stack<br />engineering</p>
      <p class="mt-3 text-ink-dim text-sm max-w-xs">TypeScript, Python and React — applications built to hold up under real load.</p>
    </div>

    <div class="hero-caption hero-caption-2">
      <div class="kicker mb-3">02 · AI systems</div>
      <p class="display text-4xl md:text-6xl text-ink">AI &amp; data<br />systems</p>
      <p class="mt-3 text-ink-dim text-sm max-w-xs ml-auto">LLM-powered tools and Python pipelines — turning raw data into working products.</p>
    </div>

    <div class="hero-caption hero-caption-3">
      <div class="kicker mb-3">03 · Endurance</div>
      <p class="display text-4xl md:text-6xl text-ink">Trail<br />runner</p>
      <p class="mt-3 text-ink-dim text-sm max-w-sm mx-auto">Ultra-distance discipline from the mountains of Mauritius, applied to shipping software.</p>
    </div>

    <!-- Scroll cue -->
    <div class="hero-scrollcue absolute bottom-8 left-1/2 -translate-x-1/2 z-10 opacity-0 animate-[fadeUp_0.6s_1.2s_ease_forwards]">
      <div class="flex flex-col items-center gap-2 text-ink-faint">
        <span class="font-mono text-[0.6rem] tracking-[0.3em] uppercase">Scroll</span>
        <div class="w-px h-8 bg-gradient-to-b from-ink-faint to-transparent"></div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initHeroScene } from '../lib/topo/topo-scene';

  initHeroScene();
  document.addEventListener('astro:after-swap', initHeroScene);
</script>
