---
export const prerender = true;

import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import running1 from '../assets/photos/running_1.jpeg';
import running2 from '../assets/photos/running_2.jpeg';
import presenting1 from '../assets/photos/presenting_1.jpeg';
---

<BaseLayout
  title="About"
  description="Kherin Bundhoo — AI Engineer, Data Scientist, and Trail Runner from Mauritius. Background, tech stack, and community involvement."
>
  <!-- Page header with night-race photo -->
  <div class="relative border-b border-line overflow-hidden bg-night-900">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 items-stretch">
      <div class="px-6 py-16 flex flex-col justify-center">
        <div class="kicker mb-4">About</div>
        <h1 class="page-title display text-5xl md:text-7xl text-ink mb-5">
          The athlete-<br />engineer
        </h1>
        <p class="text-ink-dim max-w-md">
          AI engineer by trade, trail runner by obsession — both practised
          on a small island with big mountains.
        </p>
      </div>
      <div class="relative min-h-[280px] md:min-h-0">
        <Image
          src={running1}
          alt="Kherin running through a city street at night wearing bib number 49"
          widths={[480, 800, 1200, 1600, 1983]}
          sizes="(min-width: 768px) 50vw, 100vw"
          format="webp"
          quality={80}
          class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-night-900 via-transparent to-transparent hidden md:block" aria-hidden="true"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-night-900 via-transparent to-transparent md:hidden" aria-hidden="true"></div>
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-6 py-16 space-y-20">

    <!-- 01 · Profile -->
    <section class="reveal grid grid-cols-1 md:grid-cols-5 gap-10 items-start" aria-labelledby="bio-heading">
      <div class="md:col-span-3">
        <div class="flex items-baseline gap-4 mb-6">
          <span class="section-num text-5xl">01</span>
          <div class="kicker">Profile</div>
        </div>
        <h2 id="bio-heading" class="display text-3xl text-ink mb-6">Kherin Bundhoo</h2>

        <div class="space-y-4 text-ink-dim leading-relaxed">
          <p>
            I'm an <strong class="text-ink font-medium">AI engineer</strong> from
            <strong class="text-ink font-medium">Mauritius 🇲🇺</strong>. My work sits where large
            language models, data, and product engineering meet: building LLM-powered tools,
            designing data pipelines, and shipping the full-stack applications that carry them.
          </p>
          <p>
            I work across Python and TypeScript day-to-day — everything from NestJS APIs and React
            frontends to Jupyter notebooks and Flutter apps. A current thread is
            <strong class="text-ink font-medium">sports analytics</strong>: tools that turn raw GPS
            and race data into insight for trail runners and race organisers here in Mauritius.
          </p>
          <p>
            When I'm off the keyboard I'm on trails. Running shapes how I think about systems —
            pace, endurance, incremental improvement. If a training block is a sprint, a project
            is a stage race.
          </p>
        </div>
      </div>

      <!-- Side panel: quick facts -->
      <div class="md:col-span-2 space-y-3" data-delay="1">
        {[
          { label: 'Location',    value: 'Mauritius 🇲🇺' },
          { label: 'Focus',       value: 'AI engineering & data science' },
          { label: 'Status',      value: 'Open to work ✓' },
          { label: 'Community',   value: 'PYMUG member & speaker' },
          { label: 'Languages',   value: 'Python · TypeScript · Dart' },
          { label: 'Off-duty',    value: 'Trail running 🏃' },
        ].map(({ label, value }) => (
          <div class="card p-4 flex items-start gap-3">
            <span class="font-mono text-[0.65rem] text-ember tracking-wider uppercase min-w-[90px] pt-0.5">{label}</span>
            <span class="text-ink text-sm">{value}</span>
          </div>
        ))}
      </div>
    </section>

    <div class="rule" aria-hidden="true"></div>

    <!-- 02 · Current focus -->
    <section class="reveal" aria-labelledby="focus-heading">
      <div class="flex items-baseline gap-4 mb-6">
        <span class="section-num text-5xl">02</span>
        <div class="kicker">Now</div>
      </div>
      <h2 id="focus-heading" class="display text-4xl text-ink mb-8">Current focus</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        {[
          {
            title: 'LLM research & tooling',
            desc:  'Investigating how large language models can generate and autonomously integrate code — Project Mitosis is the live experiment.',
          },
          {
            title: 'Sports analytics',
            desc:  'Building GPS and race-data tools for trail running — scraping results, analysing Garmin GPX tracks, generating performance reports.',
          },
          {
            title: 'Computer vision & OCR',
            desc:  'Document-scanning pipelines that extract structured data from images using OpenCV, MediaPipe, and Azure Form Recognizer.',
          },
        ].map(({ title, desc }, i) => (
          <div class="card p-6 flex flex-col gap-3" data-delay={i}>
            <span class="section-num text-2xl">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="font-display text-lg text-ink">{title}</h3>
            <p class="text-ink-dim text-sm leading-relaxed flex-1">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <div class="rule" aria-hidden="true"></div>

    <!-- 03 · Tech stack -->
    <section class="reveal" aria-labelledby="stack-heading">
      <div class="flex items-baseline gap-4 mb-6">
        <span class="section-num text-5xl">03</span>
        <div class="kicker">Stack</div>
      </div>
      <h2 id="stack-heading" class="display text-4xl text-ink mb-8">Tech stack</h2>

      <div class="space-y-8">
        {[
          {
            label: 'Languages',
            items: ['Python', 'TypeScript', 'JavaScript', 'Dart', 'SQL'],
          },
          {
            label: 'Frameworks & libraries',
            items: ['React', 'Vue.js', 'NestJS', 'Django', 'Flutter', 'Astro', 'Node.js'],
          },
          {
            label: 'AI, data science & ML',
            items: ['LLM integration', 'Pandas', 'Jupyter', 'OpenCV', 'MediaPipe', 'scikit-learn', 'Playwright', 'gpxpy', 'Azure Form Recognizer'],
          },
          {
            label: 'Cloud, DevOps & tools',
            items: ['Docker', 'Azure', 'GitHub Actions', 'Ansible', 'Semgrep', 'Git', 'Vercel'],
          },
        ].map(({ label, items }, i) => (
          <div class="reveal" data-delay={i}>
            <div class="flex items-center gap-3 mb-3">
              <span class="font-mono text-xs font-medium text-ink-dim tracking-[0.18em] uppercase">{label}</span>
              <span class="rule flex-1 w-auto"></span>
            </div>
            <div class="flex flex-wrap gap-2">
              {items.map(item => (
                <span class="font-mono text-xs text-ink border border-line px-3 py-1.5 hover:border-ember-dim hover:text-ember transition-colors duration-200 cursor-default">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <div class="rule" aria-hidden="true"></div>

    <!-- 04 · Community -->
    <section class="reveal" aria-labelledby="community-heading">
      <div class="flex items-baseline gap-4 mb-6">
        <span class="section-num text-5xl">04</span>
        <div class="kicker">Community</div>
      </div>
      <h2 id="community-heading" class="display text-4xl text-ink mb-8">Giving talks, giving back</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center mb-10">
        <figure class="m-0">
          <div class="photo-frame">
            <Image
              src={presenting1}
              alt="Kherin presenting on stage at Developers Conference 2025, with a slide reading 'Kherin Bundhoo, AI Engineer'"
              widths={[480, 800, 1200, 1600, 2400]}
              sizes="(min-width: 768px) 50vw, 100vw"
              format="webp"
              quality={80}
            />
          </div>
          <figcaption class="photo-caption">Exploring OpenData Mauritius with Python Marimo — DevCon 2025</figcaption>
        </figure>
        <div>
          <p class="text-ink-dim leading-relaxed mb-4">
            At <strong class="text-ink font-medium">Developers Conference 2025</strong> I presented
            "Exploring OpenData Mauritius with Python Marimo" — reactive notebooks applied to this
            island's public datasets.
          </p>
          <p class="text-ink-dim leading-relaxed">
            The local Python community is where much of my growth happened, and speaking is how
            I return the favour.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="card p-6">
          <div class="flex items-center gap-3 mb-4">
            <span class="font-display text-2xl text-ember">PY</span>
            <div>
              <div class="font-display text-ink">Python Mauritius User Group</div>
              <div class="font-mono text-xs text-ink-faint">PYMUG — member & speaker</div>
            </div>
          </div>
          <p class="text-ink-dim text-sm leading-relaxed">
            Active contributor to the Mauritius Python community. Gave a talk on
            <em>"Securing React packages with Semgrep"</em> — static analysis rules for common
            React security pitfalls, live demos, and OWASP top-10 vulnerabilities.
          </p>
          <div class="mt-4">
            <a
              href="https://github.com/kherin/semgrep-talk"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-ghost text-xs gap-1.5"
            >
              Talk resources ↗
            </a>
          </div>
        </div>

        <div class="card p-6">
          <div class="flex items-center gap-3 mb-4">
            <span class="font-display text-2xl text-ember">OS</span>
            <div>
              <div class="font-display text-ink">Open source</div>
              <div class="font-mono text-xs text-ink-faint">GitHub — @kherin</div>
            </div>
          </div>
          <p class="text-ink-dim text-sm leading-relaxed">
            20+ public repositories spanning AI experiments, data science tooling, mobile apps,
            web projects, GitHub Actions, and DevOps automation — from PyPI packages to Azure
            pipeline integration tests.
          </p>
          <div class="mt-4">
            <a
              href="https://github.com/kherin"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-ghost text-xs gap-1.5"
            >
              GitHub profile ↗
            </a>
          </div>
        </div>
      </div>
    </section>

    <div class="rule" aria-hidden="true"></div>

    <!-- 05 · Endurance -->
    <section class="reveal" aria-labelledby="endurance-heading">
      <div class="flex items-baseline gap-4 mb-6">
        <span class="section-num text-5xl">05</span>
        <div class="kicker">Endurance</div>
      </div>
      <h2 id="endurance-heading" class="display text-4xl text-ink mb-8">Trained on trails</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
        <div class="order-2 md:order-1">
          <p class="text-ink-dim leading-relaxed mb-4">
            Mauritius is 65 km across, but its trails climb like islands twice the size — Le Morne,
            Le Pouce, the Black River Gorges. I race on them, train on them, and then go home and
            write Python to pick apart every split.
          </p>
          <p class="text-ink-dim leading-relaxed">
            Endurance sport taught me the engineering virtues no course could: patience with long
            feedback loops, respect for recovery, and the discipline to keep moving when the
            summit is out of sight.
          </p>
        </div>
        <figure class="m-0 order-1 md:order-2">
          <div class="photo-frame">
            <Image
              src={running2}
              alt="Kherin running a daytime trail race through tropical vegetation"
              widths={[480, 910]}
              sizes="(min-width: 768px) 50vw, 100vw"
              format="webp"
              quality={80}
            />
          </div>
          <figcaption class="photo-caption">IBL On The Move</figcaption>
        </figure>
      </div>
    </section>

    <div class="rule" aria-hidden="true"></div>

    <!-- 06 · Learning -->
    <section class="reveal" aria-labelledby="learning-heading">
      <div class="flex items-baseline gap-4 mb-6">
        <span class="section-num text-5xl">06</span>
        <div class="kicker">Learning</div>
      </div>
      <h2 id="learning-heading" class="display text-4xl text-ink mb-8">Always in training</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <a
          href="https://www.kaggle.com/kherin/code"
          target="_blank"
          rel="noopener noreferrer"
          class="card p-6 flex items-center gap-4 group no-underline"
        >
          <div class="w-12 h-12 bg-[#20BEFF]/10 border border-[#20BEFF]/30 flex items-center justify-center text-[#20BEFF] shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.825 23.859c-.022.092-.117.141-.281.141h-3.139c-.187 0-.351-.082-.492-.248l-5.178-6.589-1.448 1.374v5.111c0 .235-.117.352-.351.352H5.505c-.236 0-.354-.117-.354-.352V.353c0-.233.118-.353.354-.353h2.431c.234 0 .351.12.351.353v14.343l6.203-6.272c.165-.165.33-.246.495-.246h3.239c.144 0 .236.06.285.18.046.149.034.255-.036.315l-6.555 6.344 6.836 8.507c.095.104.117.208.07.334z"/></svg>
          </div>
          <div>
            <div class="font-display text-ink group-hover:text-ember transition-colors duration-200">Kaggle</div>
            <div class="font-mono text-xs text-ink-faint">Notebooks, competitions & datasets</div>
          </div>
        </a>
        <a
          href="https://www.datacamp.com/portfolio/kherin"
          target="_blank"
          rel="noopener noreferrer"
          class="card p-6 flex items-center gap-4 group no-underline"
        >
          <div class="w-12 h-12 bg-[#03EF62]/10 border border-[#03EF62]/30 flex items-center justify-center text-[#03EF62] shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.931 8.67L10.35 7.246c-.198-.11-.428-.11-.626 0l-2.58 1.423A1.246 1.246 0 0 0 6.5 9.773v2.861c0 .453.242.872.644 1.098l2.58 1.424c.2.11.428.11.626 0l.9-.496v2.48l-3.68 2.032-7.07-3.904V7.437L7.57 3.533l4.62 2.55V8.67zm-1.86 6.66l3.68-2.03 7.07 3.904v7.026l-7.07 3.906-3.68-2.032v-2.48l.9.497c.2.11.427.11.626 0l2.58-1.424a1.25 1.25 0 0 0 .644-1.098v-2.86a1.25 1.25 0 0 0-.644-1.1l-2.58-1.42c-.2-.112-.427-.112-.627 0l-.9.496V15.33z"/></svg>
          </div>
          <div>
            <div class="font-display text-ink group-hover:text-ember transition-colors duration-200">DataCamp</div>
            <div class="font-mono text-xs text-ink-faint">Courses, projects & skill tracks</div>
          </div>
        </a>
      </div>
    </section>

  </div>
</BaseLayout>
