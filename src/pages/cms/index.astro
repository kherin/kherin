---
export const prerender = false;
import '../../styles/global.css';

// Redirect if already authenticated
const session = Astro.cookies.get('cms_session')?.value;
const secret = process.env.KEYSTATIC_SECRET;
if (session && secret && session === secret) {
  return Astro.redirect('/keystatic');
}

const error = Astro.url.searchParams.get('error');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CMS — Kherin</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="bg-night-950 text-ink min-h-screen flex items-center justify-center">
    <div class="w-full max-w-sm px-6">
      <!-- Wordmark -->
      <div class="mb-8 text-center">
        <span class="font-display text-3xl text-ink">Kherin Bundhoo</span>
        <p class="font-mono text-xs tracking-[0.25em] uppercase text-ink-dim mt-1">CMS admin</p>
      </div>

      <!-- Card -->
      <div class="border border-line bg-night-900 p-8 relative overflow-hidden">
        <!-- Amber spine -->
        <div class="absolute top-0 left-0 w-px h-full bg-ember"></div>

        <h1 class="font-mono text-sm tracking-[0.18em] uppercase text-ink-dim mb-6">
          Sign in
        </h1>

        {error && (
          <div class="mb-4 px-3 py-2 border border-ember/50 bg-ember/10 text-ember font-mono text-xs tracking-wide">
            Invalid password. Try again.
          </div>
        )}

        <form method="POST" action="/api/auth/login" class="flex flex-col gap-4">
          <div class="flex flex-col gap-1.5">
            <label for="password" class="font-mono text-xs tracking-[0.18em] uppercase text-ink-dim">
              Password
            </label>
            <input
              id="password"
              name="password"
              type="password"
              required
              autofocus
              class="bg-night-950 border border-line text-ink font-mono text-sm px-3 py-2 focus:outline-none focus:border-ember transition-colors duration-200"
            />
          </div>

          <button
            type="submit"
            class="btn w-full justify-center mt-2"
          >
            Enter
          </button>
        </form>
      </div>
    </div>
  </body>
</html>
