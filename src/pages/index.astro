---
export const prerender = true;

import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SkillsSection from '../components/SkillsSection.astro';
import BlogSection from '../components/BlogSection.astro';
import running1 from '../assets/photos/running_1.jpeg';
import presenting1 from '../assets/photos/presenting_1.jpeg';
---

<BaseLayout
  title="Kherin Bundhoo"
  description="AI Engineer, Data Scientist and Trail Runner from Mauritius. Building LLM-powered tools, data pipelines, and full-stack applications."
>
  <Hero />

  <!-- 01 · About feature -->
  <section class="py-24 px-6 max-w-6xl mx-auto" aria-label="About">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div class="reveal">
        <div class="flex items-baseline gap-4 mb-6">
          <span class="section-num text-5xl">01</span>
          <div class="kicker">About</div>
        </div>
        <h2 class="display text-4xl md:text-5xl text-ink mb-6">
          Engineer by trade,<br />endurance athlete by night
        </h2>
        <p class="text-ink-dim leading-relaxed mb-4">
          I'm <strong class="text-ink font-medium">Kherin Bundhoo</strong>, an AI engineer from Mauritius.
          I build LLM-powered tools, data pipelines, and full-stack applications — and I spend a lot
          of early mornings and late nights on this island's trails.
        </p>
        <p class="text-ink-dim leading-relaxed mb-8">
          The two feed each other: running gives me the patience for long problems, and engineering
          gives me an excuse to analyse every GPX file I bring home.
        </p>
        <a href="/about" class="btn inline-flex items-center gap-2">
          Full profile
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>

      <figure class="reveal m-0" data-delay="1">
        <div class="photo-frame">
          <Image
            src={running1}
            alt="Kherin running through a city street at night wearing bib number 49"
            widths={[480, 800, 1200, 1600, 1983]}
            sizes="(min-width: 768px) 50vw, 100vw"
            format="webp"
            quality={80}
          />
        </div>
        <figcaption class="photo-caption">City Urban Race · bib 49</figcaption>
      </figure>
    </div>

    <!-- Stats: big numerals over hairline rules -->
    <div class="reveal grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-10 mt-20">
      {[
        { num: '5+',    label: 'Years shipping software' },
        { num: '20+',   label: 'Open-source repos' },
        { num: '2',     label: 'Conference talks' },
        { num: '🇲🇺',   label: 'Based in Mauritius' },
      ].map(({ num, label }, i) => (
        <div data-delay={i}>
          <div class="rule mb-4"></div>
          <div class="display text-4xl md:text-5xl text-ink mb-2">{num}</div>
          <div class="font-mono text-[0.65rem] text-ink-dim tracking-[0.14em] uppercase">{label}</div>
        </div>
      ))}
    </div>
  </section>

  <div class="rule max-w-6xl mx-auto" aria-hidden="true"></div>

  <SkillsSection />

  <div class="rule max-w-6xl mx-auto" aria-hidden="true"></div>

  <!-- 03 · Selected work: editorial index rows -->
  <section class="py-24 px-6 max-w-6xl mx-auto" aria-labelledby="featured-heading">
    <div class="reveal flex items-end justify-between mb-12 flex-wrap gap-4">
      <div>
        <div class="flex items-baseline gap-4 mb-6">
          <span class="section-num text-5xl">03</span>
          <div class="kicker">Selected work</div>
        </div>
        <h2 id="featured-heading" class="display text-4xl md:text-5xl text-ink">
          Things I've built
        </h2>
      </div>
      <a href="/portfolio" class="btn-ghost btn flex items-center gap-2">
        Full portfolio
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

    <div class="reveal">
      {[
        {
          title: 'Project Mitosis',
          desc:  'LLMs generating and self-integrating code into a live running app.',
          tags:  ['LLM', 'JavaScript'],
          href:  'https://github.com/kherin/mitosis',
        },
        {
          title: 'GTrail race data scraper',
          desc:  'Automated race-result scraping and styled report generation from PowerBI trail dashboards.',
          tags:  ['Python', 'Playwright', 'Pandas'],
          href:  'https://github.com/kherin/gtrail_data',
        },
        {
          title: 'Kondir',
          desc:  'Flutter app for learning Mauritius traffic signs with incremental ML.',
          tags:  ['Flutter', 'ML'],
          href:  'https://github.com/kherin/kondir',
        },
      ].map(({ title, desc, tags, href }, i) => (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="group grid grid-cols-[auto_1fr_auto] items-baseline gap-4 md:gap-8 py-7 border-t border-line no-underline"
          data-delay={i}
        >
          <span class="section-num text-2xl md:text-3xl">{String(i + 1).padStart(2, '0')}</span>
          <span class="min-w-0">
            <span class="display block text-2xl md:text-3xl text-ink group-hover:text-ember transition-colors duration-200">{title}</span>
            <span class="block text-ink-dim text-sm mt-2 leading-relaxed">{desc}</span>
            <span class="flex flex-wrap gap-1.5 mt-3">
              {tags.map(t => <span class="tag">{t}</span>)}
            </span>
          </span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-ink-faint group-hover:text-ember group-hover:translate-x-1 transition-all duration-200 self-center"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      ))}
      <div class="rule"></div>
    </div>
  </section>

  <!-- 04 · Speaking band -->
  <section class="py-24 px-6 bg-night-900 border-y border-line" aria-labelledby="speaking-heading">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <figure class="reveal m-0 md:order-1 order-2">
        <div class="photo-frame">
          <Image
            src={presenting1}
            alt="Kherin presenting on stage at Developers Conference 2025, with a slide reading 'Kherin Bundhoo, AI Engineer'"
            widths={[480, 800, 1200, 1600, 2400]}
            sizes="(min-width: 768px) 50vw, 100vw"
            format="webp"
            quality={80}
          />
        </div>
        <figcaption class="photo-caption">Exploring OpenData Mauritius with Python Marimo — DevCon 2025</figcaption>
      </figure>

      <div class="reveal md:order-2 order-1" data-delay="1">
        <div class="flex items-baseline gap-4 mb-6">
          <span class="section-num text-5xl">04</span>
          <div class="kicker">Speaking</div>
        </div>
        <h2 id="speaking-heading" class="display text-4xl md:text-5xl text-ink mb-6">
          Sharing what I learn
        </h2>
        <p class="text-ink-dim leading-relaxed mb-4">
          At Developers Conference 2025 I walked a full room through exploring Mauritius open data
          with Python and Marimo notebooks. Before that, I spoke at the Python Mauritius User Group
          on securing React packages with Semgrep.
        </p>
        <p class="text-ink-dim leading-relaxed mb-8">
          Community is how I learned this craft — giving talks is how I pay it back.
        </p>
        <a href="https://github.com/kherin/semgrep-talk" target="_blank" rel="noopener noreferrer" class="btn btn-ghost inline-flex items-center gap-2">
          Talk resources ↗
        </a>
      </div>
    </div>
  </section>

  <BlogSection />

  <div class="rule max-w-6xl mx-auto" aria-hidden="true"></div>

  <!-- 06 · Contact band -->
  <section class="py-24 px-6" aria-label="Contact">
    <div class="max-w-3xl mx-auto text-center reveal">
      <div class="kicker justify-center mb-4">06 · Contact</div>
      <h2 class="display text-4xl md:text-5xl text-ink mb-5">
        Let's build something
      </h2>
      <p class="text-ink-dim mb-8 max-w-xl mx-auto">
        Open to opportunities, collaborations, and conversations about AI, data, or trail running.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="https://github.com/kherin" target="_blank" rel="noopener noreferrer" class="btn gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          GitHub
        </a>
        <a href="https://www.kaggle.com/kherin" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">Kaggle</a>
        <a href="https://www.datacamp.com/portfolio/kherin" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">DataCamp</a>
      </div>
    </div>
  </section>
</BaseLayout>
