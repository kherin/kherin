# Astro server
HOST=0.0.0.0
PORT=4321

# Public site URL (used for canonical URLs and sitemap)
PUBLIC_SITE_URL=https://kherin.com

# Keystatic GitHub App credentials. Generate KEYSTATIC_SECRET with:
# openssl rand -base64 32
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
# Public and required while building the image; this is not a runtime secret.
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
